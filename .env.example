# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY   # server only, never expose to the browser

# Public base URL of the separate referral redirect service.
NEXT_PUBLIC_REFERRAL_URL=https://al-euro-referrals.onrender.com

# SYR Rates API key from @api365. Server only; never use NEXT_PUBLIC_.
SYR_RATES_API_KEY=YOUR-SYR-RATES-API-KEY

# Long random string used to sign session cookies and hash passwords (changing it logs everyone out
# AND invalidates every stored password hash - set it once and keep it).
AUTH_SECRET=CHANGE-ME-TO-A-LONG-RANDOM-STRING

# Firebase Admin SDK (server-side only; use a newly generated service-account key in Render).
# Never commit the private key or place it in a NEXT_PUBLIC_ variable.
FIREBASE_PROJECT_ID=euro-cars-9455f
FIREBASE_CLIENT_EMAIL=YOUR-FIREBASE-SERVICE-ACCOUNT-EMAIL
FIREBASE_PRIVATE_KEY=YOUR-ROTATED-PRIVATE-KEY

# Protects the daily debt-reminder endpoint called by a Render Cron Job.
CRON_SECRET=CHANGE-ME-TO-A-LONG-RANDOM-SECRET

# Transactional email for account-deletion verification codes (Resend).
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=EURO <no-reply@your-verified-domain.com>

# --- Security hardening (all optional; safe defaults apply when unset) ---
# Phone-ownership proof (SMS code) for sign-up. Leave unset/false to keep the current behaviour;
# set to "true" only after the registration_otp_codes migration is applied and MsgPlus SMS is verified.
REGISTRATION_OTP_ENABLED=false
# Upper limit of SMS verification messages the server will send per day, all purposes together (default 500).
OTP_DAILY_CAP=500

# --- MsgPlus SMS (the only channel for verification codes; no WhatsApp / Green API / Firebase SMS) ---
# MsgPlus API v1 sends a message from an APPROVED TEMPLATE: only the template's variable is sent (the bare code).
# The approved template text should be:  EURO CARS: رمز التحقق [[P1]] صالح 10 دقائق. لا تشاركه.
# Simple setup: these four variables are enough. URL, "Authorization: Bearer", X-Timestamp, Accept and the success check
# (reply.success === true) are derived from the documented MsgPlus contract.
# SECRET: set the key only in Render (never here, never in the apps).
MSGPLUS_API_KEY=
MSGPLUS_SENDER_ID=157
MSGPLUS_TEMPLATE_ID=1
MSGPLUS_OTP_VAR_NAME=P1
# Advanced / other providers (leave unset for MsgPlus; when set they override the derived values):
# MSGPLUS_API_URL=https://sms.msgplus.tech/api/v1/send
# MSGPLUS_BODY_TEMPLATE={"sender_id":157,"template_id":1,"numbers":["{{to}}"],"vars":{"P1":"{{code}}"}}
# MSGPLUS_AUTH_HEADER=Authorization
# MSGPLUS_AUTH_VALUE=Bearer <key>
# MSGPLUS_TIMESTAMP_HEADER=X-Timestamp
# MSGPLUS_PHONE_FORMAT=international
# MSGPLUS_SUCCESS_FIELD=success
# MSGPLUS_SUCCESS_VALUE=true
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts admin two-step-verification secrets.
# If unset, a key derived from AUTH_SECRET is used (rotating AUTH_SECRET would then lock enrolled admins out).
TOTP_ENC_KEY=
# Emergency switch for a lost authenticator phone: "true" skips the admin second step. Remove it again afterwards.
ADMIN_2FA_DISABLED=
# One-off administrator password reset (/api/admin/reset-password). Works only while BOTH are set:
# a random token of 32+ characters and an expiry (ISO date, e.g. 2026-11-15T09:00:00Z) at most 24 hours ahead.
# Remove both again right after use.
ADMIN_PASSWORD_RESET_TOKEN=
ADMIN_PASSWORD_RESET_EXPIRES_AT=
