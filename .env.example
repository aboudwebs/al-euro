# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY   # server only, never expose to the browser

# SYR Rates API key from @api365. Server only; never use NEXT_PUBLIC_.
SYR_RATES_API_KEY=YOUR-SYR-RATES-API-KEY

# Long random string used to sign session cookies and hash passwords (changing it logs everyone out
# AND invalidates every stored password hash - set it once and keep it).
AUTH_SECRET=CHANGE-ME-TO-A-LONG-RANDOM-STRING

# Firebase Admin SDK (server-side only; use a newly generated service-account key in Render).
# Never commit the private key or place it in a NEXT_PUBLIC_ variable.
FIREBASE_PROJECT_ID=euro-cars-9455f
FIREBASE_CLIENT_EMAIL=YOUR-FIREBASE-SERVICE-ACCOUNT-EMAIL
FIREBASE_PRIVATE_KEY=YOUR-ROTATED-PRIVATE-KEY

# Protects the daily debt-reminder endpoint called by a Render Cron Job.
CRON_SECRET=CHANGE-ME-TO-A-LONG-RANDOM-SECRET
